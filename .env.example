# ---- Model provider -------------------------------------------------------
# "ollama"  -> local model (default)
# "bedrock" -> Amazon Bedrock (required for the deployed AgentCore Runtime)
MODEL_PROVIDER=ollama

# ---- Ollama (local, free) -------------------------------------------------
# Use a model that supports tool calling (e.g. llama3.1, qwen2.5).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=llama3.1

# ---- Bedrock (only when MODEL_PROVIDER=bedrock) ---------------------------
AWS_REGION=
BEDROCK_MODEL_ID=
# Use a tool-capable model that is enabled in your account.

# ---- Execution management -------------------------------------------------
MAX_SESSIONS=100            # max concurrent agent conversations kept in memory
SESSION_TTL_SECONDS=1800    # idle sessions are dropped after this long

# ---- Misc -----------------------------------------------------------------
LOG_LEVEL=INFO
# Set to 1 to make create_order raise, to test failure handling end to end.
SIMULATE_TOOL_FAILURE=0
