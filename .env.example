# ---- Model provider -------------------------------------------------------
# "ollama"  -> free, local model (default; no AWS cost)
# "bedrock" -> Amazon Bedrock (costs money / uses credits; REQUIRED for the
#              deployed AgentCore Runtime, which cannot reach your laptop)
MODEL_PROVIDER=ollama

# ---- Ollama (local, free) -------------------------------------------------
# Use a model that supports tool calling (e.g. llama3.1, qwen2.5).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=llama3.1

# ---- Bedrock (only when MODEL_PROVIDER=bedrock) ---------------------------
AWS_REGION=
BEDROCK_MODEL_ID=
# Pick a small/cheap tool-capable model that is enabled in your account.

# ---- Misc -----------------------------------------------------------------
LOG_LEVEL=INFO
# Set to 1 to make create_order raise, to test failure handling end to end.
SIMULATE_TOOL_FAILURE=0
